# Copy to .env.local. Anon key is fine client-side; RLS is wide open for the demo.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (route handlers). Resend for /api/dispatch.
RESEND_API_KEY=
DISPATCH_FROM_EMAIL=bachero@example.com

# Base URL used in dispatch emails for /route/{id} links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OSRM. Public demo server by default; rate-limited, no SLA.
OSRM_BASE_URL=https://router.project-osrm.org

# Prefills the Dispatch email field on the console (optional).
NEXT_PUBLIC_DEMO_CREW_EMAIL=
