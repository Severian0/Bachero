# Copy to .env.local. Anon key is fine client-side; RLS is wide open for the demo.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (route handlers). Resend for /api/dispatch.
# Optional: without a key /api/dispatch still publishes the plan and answers
# sent: false, so the demo works offline. Sending from onboarding@resend.dev
# (the default) only reaches the address that owns the Resend account; to mail
# anyone else, verify a domain and set DISPATCH_FROM_EMAIL to an address on it.
RESEND_API_KEY=
DISPATCH_FROM_EMAIL=onboarding@resend.dev

# Base URL for the /route/{id} crew page link in dispatch emails. Default
# http://localhost:3000; set it to the deployed URL or the crew's phone cannot
# open the link.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OSRM. Public demo server by default; rate-limited, no SLA. If it fails the
# plan still returns, on straight-line distances, marked estimated.
OSRM_BASE_URL=https://router.project-osrm.org

# Time zone the crew shift is scheduled in. plan_date is a calendar day, so the
# 08:00 start needs a zone to resolve against; the server's own zone is UTC once
# deployed, which would put every ETA an hour out through British Summer Time.
AUTHORITY_TIME_ZONE=Europe/London

# Prefills the Dispatch email field on the console (optional).
NEXT_PUBLIC_DEMO_CREW_EMAIL=

# Shown in the console header in place of "Demo Council" (optional).
NEXT_PUBLIC_AUTHORITY_NAME=
