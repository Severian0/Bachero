# Copy to .env.local. Anon key is fine client-side; RLS is wide open for the demo.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (route handlers). Resend for /api/dispatch.
RESEND_API_KEY=
DISPATCH_FROM_EMAIL=bachero@example.com

# Base URL used in dispatch emails for /route/{id} links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OSRM. Public demo server by default; rate-limited, no SLA.
OSRM_BASE_URL=https://router.project-osrm.org

# Google Maps JavaScript API. Restrict the key by HTTP referrer before it
# leaves your machine: any browser key is visible in the page source.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
