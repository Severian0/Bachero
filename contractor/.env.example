# Copy to .env.local.
#
# Leave NEXT_PUBLIC_SUPABASE_URL unset and the app runs on fixture data: three
# crews, four route plans, twenty-six stops, and every action working locally.
# Set it and the same screens read and write the real database instead.
# Anon key is fine client-side; RLS is wide open for the demo (see the migration).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Whose work this portal shows. Defaults to the seeded Demo Council authority in
# supabase/migrations/20260901000000_init.sql.
NEXT_PUBLIC_AUTHORITY_ID=00000000-0000-0000-0000-000000000001
